# Production URL configuration (Phase 19). All values are PUBLIC
# (Vite embeds them in the client bundle) — never put secrets here.
#
# Public origin used for canonical URLs, og:url, and sitemap.
# Leave UNSET for local/preview builds (no canonical beats a wrong one).
# VITE_SITE_URL=https://example.com
#
# Subpath hosting, e.g. https://example.com/gitverse/ .
# Defaults to / (domain root, recommended).
# VITE_BASE_PATH=/gitverse/
